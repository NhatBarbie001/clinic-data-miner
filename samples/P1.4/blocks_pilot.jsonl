{"id": "blk_9cc28e55da35f2b7", "schema_version": 1, "kind": "list_item", "text": "Viêm nhiều khớp nhỏ ở bàn tay như khớp cổ tay, khớp bàn ngón và khớp ngón gần, có tính chất đối xứng hai bên.", "text_rules": "Viêm nhiều khớp nhỏ ở bàn tay như khớp cổ tay, khớp bàn ngón và kbớp ngón gần, có tính chất đối xứng hai bên.", "page_start": 4, "page_end": 4, "printed_start": 1, "printed_end": 1, "line_ids": ["ln_9cc28e55da35f2b7", "ln_7ad5141a7d752621"], "bbox": [58.0, 458.8, 347.0, 472.8], "x0": 58.0, "font_size": 10.44, "is_upper": false, "numbering": null, "marker": "-", "rows": null, "flags": [], "fixes": [{"position": 15, "before": "kbớp", "after": "khớp", "accepted": true, "rule": "ok", "suggestion": null, "cell": null}]}
